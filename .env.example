# Browser client. Use the publishable key (sb_publishable_...) or the legacy anon key.
# Never put the service role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# CLI only (scripts/import-localstorage.ts). Do not import this from src/.
SUPABASE_SERVICE_ROLE_KEY=

# Map agent. Same switch as mdmp-curs. Opper is the OpenAI-compatible endpoint.
# AGENT_MODEL_PROVIDER=gateway uses a Vercel AI Gateway model id.
# AGENT_MODEL_PROVIDER=opper uses OPPER_API_KEY. The default model is DeepSeek V4 Flash.
AGENT_MODEL_PROVIDER=opper
AGENT_MODEL=deepinfra/deepseek-v4-flash-0731
OPPER_BASE_URL=https://api.opper.ai/v3/compat
OPPER_API_KEY=
